create table location_lists -- NO_IMPORT
(
	object_id number, -- BIND_AS(DB::BindableNetworkId)
	list_id number, -- BIND_AS(DB::BindableUint32)
	sequence_number number, -- BIND_AS(DB::BindableUint32)
	name varchar2(255),
	scene varchar2(50),
	x number, -- BIND_AS(DB::BindableDouble)
	y number, -- BIND_AS(DB::BindableDouble)
	z number, -- BIND_AS(DB::BindableDouble)
	radius number, -- BIND_AS(DB::BindableDouble)
	constraint pk_location_lists primary key (object_id, list_id, sequence_number)
);
grant select on location_lists to public;
